{
  "private": true,
  "name": "remnote-page-strip",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Firefox style page thumbnails and bookmarks beside PDF and HTML documents in RemNote.",
  "scripts": {
    "clean": "shx rm -rf dist *.zip",
    "dev": "node scripts/dev.mjs",
    "free-port": "node scripts/free-port.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "check-types": "tsc",
    "verify": "npm run check-types && npm test",
    "pre-push": "npm run verify",
    "build": "npm run verify && shx rm -rf dist && shx rm -f PageStripPlugin.zip && cross-env NODE_ENV=production webpack --color && shx cp README.md dist && cd dist && bestzip ../PageStripPlugin.zip ./*"
  },
  "dependencies": {
    "@remnote/plugin-sdk": "^0.0.46",
    "pdfjs-dist": "^6.4.299",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^17.0.2",
    "@types/react-dom": "^17.0.2",
    "bestzip": "^2.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "esbuild-loader": "^4.3.0",
    "glob": "^11.0.3",
    "shx": "^0.3.4",
    "typescript": "^5.6.3",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  }
}
